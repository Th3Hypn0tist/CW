{
  "id": "UML_NODETYPES",
  "name": "UML NodeTypes",
  "version": "1.0.0",
  "purpose": "Define UML node categories and the semantic properties each node type owns or may own.",
  "principles": [
    "NodeTypes define node-local semantic structure.",
    "NodeTypes do not define relationship interpretation.",
    "NodeTypes do not define flow or traversal semantics.",
    "NodeTypes do not define rendering or layout.",
    "Missing expected properties make a node unready for rules that require them; they do not make the node invalid."
  ],
  "nodetype_schema": {
    "required": [
      "id",
      "name",
      "required_properties",
      "owned_properties"
    ],
    "optional": [
      "extends",
      "property_cardinality",
      "description"
    ]
  },
