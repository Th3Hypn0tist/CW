{
  "id": "CW_RULESETS",
  "name": "CanonicalWireframe Dependency Rules",
  "version": "2.2.0",
  "ccf_ref": "CANONICAL_CONTRACT_FORMAT",
  "nodetypes_ref": "CW_NODETYPES",
  "purpose": "Define how CanonicalWireframe interprets CCF Properties, Links, required Link minima, abstraction boundary nodes, Events, Effects, causal relations and flow.",
  "principles": [
    "Canonical CCF structure remains authoritative.",
    "NodeTypes define Entity-local Property expectations and required Link minima.",
    "Rulesets define Property value semantics and Link interpretation.",
    "Rulesets resolve whether actual Links satisfy NodeType Required Links.",
    "Flow semantics belong to Rulesets.",
    "NodeTypes may be used as explicit context when resolving a Ruleset.",
    "Input and Output are canonical internal abstraction nodes; their external port appearance is a derived projection.",
    "Input and Output transported semantics are derived from explicit internal bindings and MUST NOT be copied into a second canonical type field.",
    "An Input boundary node MUST NOT satisfy the required Link that it exposes.",
    "Projection behavior is derived from resolved Ruleset semantics and is not canonical Ruleset state.",
    "Visual color may be derived from resolved semantic type but MUST NOT be used to infer canonical type.",
    "No semantics are inferred from filenames, extensions, names, paths, geometry, colors or visual appearance.",
    "Unresolved Ruleset requirements produce unready state, not invalid canonical data.",
    "UNRESOLVED != INVALID"
  ],
  "flow_patterns": [
    {
      "id": "static",
      "name": "Static",
      "legs": [],
      "meaning": "The relation is semantically present but defines no transport leg."
    },
    {
      "id": "one_way",
      "name": "One Way",
      "legs": [
        {
          "phase": "transfer",
          "direction": "parent_ref_to_child_ref"
        }
      ]
    },
    {
      "id": "request_reply",
      "name": "Request Reply",
      "legs": [
        {
          "phase": "request",
          "direction": "child_ref_to_parent_ref"
        },
        {
          "phase": "reply",
          "direction": "parent_ref_to_child_ref"
        }
      ]
    },
    {
      "id": "continuous",
      "name": "Continuous",
      "legs": [
        {
          "phase": "stream",
          "direction": "parent_ref_to_child_ref",
          "continuous": true
        }
      ]
    }
  ],
  "property_rulesets": [
    {
      "id": "RULESET_MOUNT",
      "property_type_ref": "mount",
      "value_schema": {
        "required": [
          "mount_type_ref",
          "target_ref",
          "properties"
        ],
        "optional": [],
        "fields": {
          "mount_type_ref": "string",
          "target_ref": "canonical_or_external_ref",
          "properties": "object"
        }
      },
      "readiness": [
        "mount_type_ref is present",
        "target_ref is explicit"
      ]
    },
    {
      "id": "RULESET_EVENT",
      "property_type_ref": "event",
      "value_schema": {
        "required": [
          "event_type_ref",
          "properties"
        ],
        "optional": [],
        "fields": {
          "event_type_ref": "string",
          "properties": "object"
        }
      },
      "readiness": [
        "event_type_ref is present"
      ]
    },
    {
      "id": "RULESET_EFFECT",
      "property_type_ref": "effect",
      "value_schema": {
        "required": [
          "effect_type_ref",
          "properties"
        ],
        "optional": [],
        "fields": {
          "effect_type_ref": "string",
          "properties": "object"
        }
      },
      "readiness": [
        "effect_type_ref is present"
      ]
    },
    {
      "id": "RULESET_DATA",
      "property_type_ref": "data",
      "value_schema": {
        "required": [
          "data_type_ref",
          "value",
          "properties"
        ],
        "optional": [],
        "fields": {
          "data_type_ref": "string",
          "value": "inert_semantic_value",
          "properties": "object"
        }
      },
      "readiness": [
        "data_type_ref is present"
      ]
    },
    {
      "id": "RULESET_FUNCTION",
      "property_type_ref": "function",
      "value_schema": {
        "required": [
          "function_type_ref",
          "properties"
        ],
        "optional": [
          "input_refs",
          "output_refs"
        ],
        "fields": {
          "function_type_ref": "string",
          "properties": "object",
          "input_refs": "array<canonical_ref>",
          "output_refs": "array<canonical_ref>"
        }
      },
      "readiness": [
        "function_type_ref is present",
        "every input_refs and output_refs item resolves when present"
      ]
    },
    {
      "id": "RULESET_FILE",
      "property_type_ref": "file",
      "value_schema": {
        "required": [
          "filename",
          "properties"
        ],
        "optional": [],
        "fields": {
          "filename": "string",
          "properties": "object"
        }
      },
      "readiness": [
        "filename is present",
        "filename is not an empty string"
      ],
      "rule": "filename is the machine-significant external filename. Entity.name is display identity and MUST NOT substitute for filename."
    },
    {
      "id": "RULESET_API",
      "property_type_ref": "api",
      "value_schema": {
        "required": [
          "api_type_ref",
          "input_refs",
          "output_refs",
          "properties"
        ],
        "optional": [
          "endpoint"
        ],
        "fields": {
          "api_type_ref": "string",
          "input_refs": "array<canonical_ref>",
          "output_refs": "array<canonical_ref>",
          "endpoint": "string",
          "properties": "object"
        }
      },
      "readiness": [
        "api_type_ref is present",
        "every input_refs item resolves",
        "every output_refs item resolves"
      ],
      "rule": "api_type_ref defines the API kind; input_refs and output_refs define its canonical I/O surfaces. Additional API-specific settings belong in properties."
    }
  ],
