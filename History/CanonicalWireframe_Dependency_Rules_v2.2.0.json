  "required_link_resolution": {
    "source": "CW_NODETYPES.required_links",
    "steps": [
      "Resolve the Entity NodeType and its inheritance closure.",
      "Collect the effective Required Links requirements.",
      "For each requirement, resolve exactly one Link Ruleset whose link_type_ref matches.",
      "Resolve requirement.self_role against that Link Ruleset semantic_roles.",
      "Find active canonical Link Properties in which the Entity occupies that semantic role.",
      "Resolve the opposite endpoint of each candidate Link.",
      "Apply other_endpoint entity_nodetype_ref and/or property_type_ref constraints when present.",
      "Do not count boundary_input exposure as satisfying the requirement it exposes.",
      "Compare the matching active Link count against min and max.",
      "Emit readiness findings without inventing missing Links."
    ],
    "entity_nodetype_matching": "A candidate Entity matches entity_nodetype_ref when its resolved NodeType is that NodeType or inherits from it.",
    "minimum_result": "count < min => unready",
    "maximum_result": "max present and count > max => conflict",
    "unresolved_projection": {
      "rule": "Each unsatisfied minimum MAY be materialized by Structure as a derived unresolved node or slot carrying the exact Required Links constraint.",
      "canonical_authority": false,
      "must_be_rebuildable": true
    }
  },
  "boundary_model": {
    "input": {
      "nodetype_ref": "input",
      "binding_link_type_ref": "boundary_input",
      "inside_abstraction": "canonical Entity node",
      "outside_abstraction": "derived input port on the Input Entity's direct containment parent",
      "type_rule": "The external port type is derived from the explicit internal binding. No copied input_type field is canonical.",
      "required_link_rule": "When boundary_input.properties.required_link_id identifies an unresolved Required Links item on the bound internal Entity, the Input exposes that requirement but does not satisfy it.",
      "resolution_rule": "Only a compatible external canonical Link connected through the abstraction boundary can satisfy the exposed requirement."
    },
    "output": {
      "nodetype_ref": "output",
      "binding_link_type_ref": "boundary_output",
      "inside_abstraction": "canonical Entity node",
      "outside_abstraction": "derived output port on the Output Entity's direct containment parent",
      "type_rule": "The external port type is derived from the explicit internal parent_ref endpoint. No copied output_type field is canonical.",
      "requirement_rule": "Output creates no required Link by itself."
    },
    "projection_color_rule": "A renderer MAY color Input/Output nodes and projected abstraction ports by their resolved transported semantic type. Color is representation state and MUST NOT be used as semantic authority."
  },
  "event_read": {
    "parallel_reads": true,
    "effect_barrier": "Event Effects become ready after all required reads for that Event have reached their Ruleset-defined ready condition.",
    "ready_condition_by_flow": {
      "one_way": "transfer_complete",
      "request_reply": "reply_complete",
      "continuous": "ruleset_defined",
      "static": "relation_ready"
    }
  },
  "readiness": {
    "ready": "All requirements evaluated by the active Ruleset are satisfied.",
    "unready": "One or more Ruleset requirements are unresolved, missing or not yet satisfied.",
    "unready_reasons": [
      "missing_required_property",
      "missing_required_link",
      "unresolved_required_link",
      "unresolved_nodetype",
      "unresolved_endpoint",
      "unresolved_ruleset",
      "unresolved_flow",
      "cardinality_not_satisfied",
      "event_read_not_ready",
      "boundary_binding_unresolved"
    ],
    "principle": "Unready structure remains canonical, visible and editable."
  }
}
