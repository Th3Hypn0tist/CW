{
  "id": "CW_RULESETS",
  "name": "CanonicalWireframe Dependency Rules",
  "version": "2.4.0",
  "ccf_ref": "CANONICAL_CONTRACT_FORMAT",
  "nodetypes_ref": "CW_NODETYPES",
  "purpose": "Define how CanonicalWireframe interprets CCF Properties, Links, Events, Effects, causal relations, Link ownership/placement, Required Link satisfaction and flow.",
  "principles": [
    "Canonical CCF structure remains authoritative.",
    "NodeTypes define Entity-local Property expectations and mandatory Required Link declarations.",
    "Rulesets define Property value semantics, Link interpretation, semantic roles, Link Property ownership/placement, flow and unresolved impact direction.",
    "Required Link satisfaction is explicit canonical data through Link.value.required_link_ref.",
    "Projection behavior is derived from resolved Ruleset semantics and is not canonical Ruleset state.",
    "No semantics are inferred from filenames, extensions, names, paths, geometry, color or visual appearance.",
    "Unresolved Ruleset or Required Link requirements produce unready state, not invalid canonical data unless declared canonical data itself is malformed or contradictory.",
    "UNRESOLVED != INVALID",
    "Binding consumption is represented by an explicit canonical Link relation and never by free-text name lookup or transient visual trace lines.",
    "Binding trace visualization may explain canonical routing but never defines canonical routing.",
    "Forward and backward traversal through Binding follows canonical source and binding-consumption Links."
  ],
  "shared_value_types": {
    "required_link_ref": {
      "required": [
        "entity_ref",
        "required_link_id"
      ],
      "fields": {
        "entity_ref": "canonical_entity_ref",
        "required_link_id": "string"
      },
      "meaning": "Explicitly binds one canonical Link Property to one concrete Required Link requirement instance.",
      "requirement_identity": "entity_ref + required_link_id",
      "one_link_one_requirement": true
    }
  },
  "required_links": {
    "authority": "NodeType.required_links declares the requirement; the canonical Link Property remains the relationship authority.",
    "satisfaction_binding": "A Link satisfies a Required Link only when value.required_link_ref resolves to the requiring Entity and effective Required Link id.",
    "all_entries_mandatory": true,
    "same_link_type_entries_are_distinct": true,
    "derived_links_satisfy": false,
    "unbound_links_satisfy": false,
    "input_boundary_satisfies": false,
    "authoring": {
      "zero_compatible_unsatisfied": "Author the Link normally when otherwise valid; required_link_ref is absent.",
      "one_compatible_unsatisfied": "Structure may bind the newly authored Link automatically to that one requirement instance.",
      "multiple_compatible_unsatisfied": "User MUST explicitly choose exactly one compatible requirement instance before commit.",
      "no_implicit_choice": true
    },
    "validation": [
      "required_link_ref.entity_ref resolves to the requiring Entity",
      "required_link_ref.required_link_id resolves to an effective Required Link declaration on that Entity",
      "Link link_type_ref matches the declaration",
      "The requiring Entity occupies the declaration self_role",
      "Declared opposite-endpoint constraints match",
      "One Link is not reused for another concrete requirement instance"
    ],
    "invalid": "A present required_link_ref that does not resolve or contradicts Link semantics is invalid canonical data.",
    "unready": "A missing Required Link attachment leaves the requiring Entity UNRESOLVED/unready."
  },
  "flow_patterns": [
    {
      "id": "static",
      "name": "Static",
      "legs": [],
      "meaning": "The relation is semantically present but defines no transport leg."
    },
    {
      "id": "one_way",
      "name": "One Way",
      "legs": [
        {
          "phase": "transfer",
          "direction": "parent_ref_to_child_ref"
        }
      ]
    },
    {
      "id": "request_reply",
      "name": "Request Reply",
      "legs": [
        {
          "phase": "request",
          "direction": "child_ref_to_parent_ref"
        },
        {
          "phase": "reply",
          "direction": "parent_ref_to_child_ref"
        }
      ]
    },
    {
      "id": "continuous",
      "name": "Continuous",
      "legs": [
        {
          "phase": "stream",
          "direction": "parent_ref_to_child_ref",
          "continuous": true
        }
      ]
    }
  ],
