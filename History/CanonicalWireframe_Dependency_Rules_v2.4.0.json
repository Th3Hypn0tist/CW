  "event_required_targets": {
    "rule": "Event-related Required Link declarations may contain any number of independent mandatory targets.",
    "all_required": true,
    "same_link_type_allowed": true,
    "same_visual_event_socket_may_aggregate": true,
    "visual_aggregation_changes_canonical_multiplicity": false,
    "one_event_link_satisfies_multiple_required_targets": false
  },
  "event_read": {
    "parallel_reads": true,
    "effect_barrier": "Event Effects become ready after all required reads for that Event have reached their Ruleset-defined ready condition.",
    "ready_condition_by_flow": {
      "one_way": "transfer_complete",
      "request_reply": "reply_complete",
      "continuous": "ruleset_defined",
      "static": "relation_ready"
    }
  },
  "derived_dependency": {
    "rule": "Cross-owner Event use may derive a locked Entity-level dependency where the governing Event contract declares that use dependency-forming.",
    "canonical_authority": "The specific causal/Event Link remains authority.",
    "persist_as_canonical_dependency": false,
    "locked": true,
    "satisfies_required_link": false,
    "multiple_causes_may_aggregate_visually": true
  },
  "unresolved": {
    "rule": "Unresolved impact propagates only from unresolved origin through each Link Ruleset's explicit unresolved_impact direction.",
    "no_bidirectional_default": true,
    "no_geometry_or_color_inference": true,
    "required_link_origin": "The requiring Entity is the unresolved origin when any concrete Required Link requirement is below min."
  },
  "readiness": {
    "ready": "All active Property, Link, Required Link and flow requirements are satisfied.",
    "unready": "One or more requirements are unresolved, missing or not yet satisfied.",
    "unready_reasons": [
      "missing_required_property",
      "missing_required_link",
      "unresolved_nodetype",
      "unresolved_endpoint",
      "unresolved_ruleset",
      "unresolved_flow",
      "cardinality_not_satisfied",
      "event_read_not_ready",
      "binding_source_unresolved"
    ],
    "invalid_examples": [
      "required_link_ref does not resolve to the requiring Entity and effective Required Link id",
      "required_link_ref points to a requirement whose Link type, self role or endpoint constraints do not match the Link",
      "declared Link property_owner cannot be resolved through the Ruleset semantic_roles",
      "binding_consume references a Binding or Output outside the same Abstraction semantic source",
      "binding_consume parent_ref does not resolve to an Entity of NodeType binding",
      "binding_consume child_ref does not resolve to an Entity of NodeType output"
    ],
    "principle": "Unready structure remains canonical, visible and editable. UNRESOLVED != INVALID."
  },
  "authoring": {
    "direct_socket_link_creation": true,
    "link_type_resolution": "Resolve valid Link Rulesets and endpoint roles from canonical context.",
    "multiple_valid_link_types": "Require explicit Link-type choice.",
    "required_link_binding": {
      "zero_compatible_unsatisfied": "Create ordinary valid Link with no required_link_ref.",
      "one_compatible_unsatisfied": "May auto-bind to the one concrete requirement instance.",
      "multiple_compatible_unsatisfied": "Require explicit user choice of exactly one concrete requirement instance before commit."
    },
