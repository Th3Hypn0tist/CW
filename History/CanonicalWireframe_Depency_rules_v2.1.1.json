  "event_read": {
    "parallel_reads": true,
    "effect_barrier": "Event Effects become ready after all required reads for that Event have reached their Ruleset-defined ready condition.",
    "ready_condition_by_flow": {
      "one_way": "transfer_complete",
      "request_reply": "reply_complete",
      "continuous": "ruleset_defined",
      "static": "relation_ready"
    }
  },
  "readiness": {
    "ready": "All requirements evaluated by the active Ruleset are satisfied.",
    "unready": "One or more Ruleset requirements are unresolved, missing or not yet satisfied.",
    "unready_reasons": [
      "missing_required_property",
      "unresolved_nodetype",
      "unresolved_endpoint",
      "unresolved_ruleset",
      "unresolved_flow",
      "cardinality_not_satisfied",
      "event_read_not_ready"
    ],
    "principle": "Unready structure remains canonical, visible and editable."
  }
