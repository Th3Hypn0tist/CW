  "decisions": [
    {
      "candidate": "DRX_VALUE_CONDITION",
      "decision": "accepted",
      "engineering_state": "READY",
      "introduced_in": "4.1.0-reference",
      "final_available_in": "4.3.0-reference",
      "semantic": {
        "link_type_ref": "event_condition",
        "condition_mode": "value_equals",
        "required_field": "expected_value",
        "supported_expected_types": ["boolean", "integer", "string"],
        "comparison": "type-preserving exact equality",
        "unready_behavior": "UNBOUND or INVALID parent Data is unsatisfied because no valid comparison value exists; it is not false and not unequal",
        "unequal_behavior": "READY but unequal parent Data is deterministically unsatisfied"
      },
      "rejected_alternatives": [
        "reinterpret READY as boolean true",
        "arbitrary predicate expressions",
        "runtime code predicates",
        "implicit type coercion"
      ]
    },
    {
      "candidate": "DRX_DYNAMIC_DISPATCH",
      "decision": "accepted",
      "engineering_state": "READY",
      "introduced_in": "4.3.0-reference",
      "semantic": {
        "link_type_ref": "event_dispatch",
        "parent_ref": "dispatching Function",
        "child_ref": "dispatch domain Entity",
        "selector_ref": "Data Property",
        "selector_runtime_value": "exact canonical Event Property.id",
        "domain": "exactly one members Property owned by child_ref Entity",
        "allowed_target": "Event whose owning Entity is a direct member_ref of the dispatch domain",
        "emit_form": "emit with dispatch_ref instead of cause_ref",
        "context": "selected Event preserves current execution context",
        "invalid_behavior": "non-READY selector, non-string value, unresolved Property.id, non-Event target, missing domain membership surface or out-of-domain Event is INVALID dispatch"
      },
      "authority_limit": "No aliases, command tokens, filenames, paths or arbitrary executable target strings are interpreted by event_dispatch.",
      "rejected_alternatives": [
        "function_call",
        "logic op=call",
        "opaque executable target string",
        "unbounded domain_ref",
        "arbitrary Entity invocation"
      ]
    },
