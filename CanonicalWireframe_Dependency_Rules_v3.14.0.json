{
  "id": "CW_RULESETS",
  "name": "CanonicalWireframe Dependency Rules",
  "version": "3.14.0",
  "ccf_ref": "CANONICAL_CONTRACT_FORMAT",
  "nodetypes_ref": "CW_NODETYPES",
  "purpose": "Define how canonical CW Nodes and their contents are read at code level. RULESET_NODE governs the Node root; Property and Link Rulesets govern semantic contents. The selected immutable specification set may replace the NodeTypes and Rulesets registries without changing the CW import format.",
  "principles": [
    "Canonical CCF structure remains authoritative.",
    "RULESET_NODE governs the Node itself from the Entity root. It is not a Property wrapper.",
    "Every Node is interpreted through the same RULESET_NODE; Entity.entity_type_ref selects a NodeType and that NodeType declares which semantic sections are available.",
    "NodeTypes define what exists to present. Rulesets define how it is read. Renderers define how it is shown.",
    "StructureTree provides hierarchical navigation. Canonical Links provide relational navigation. Both navigate the same canonical Nodes.",
    "Generic Links require no registered relation vocabulary: the explicit relation label is read and preserved exactly.",
    "For RULESET_LINK, a link_type_ref beginning with # is a canonical topology identity reference and MUST resolve as canonical identity; a link_type_ref without # is a literal open relation name and MUST be preserved without identity inference.",
    "A topology identity Link expresses only parent/child hierarchy inside that selected topology. It does not imply dependency, causality, ownership, authority, containment or implementation semantics.",
    "Specialized Link Rulesets are optional and add semantics only when more than generic relation navigation is required.",
    "Contract members and implementation-side contract affiliation are distinct claims and MUST NOT be collapsed into one authority.",
    "Required Links are interpreted by RULESET_NODE and do not require a dedicated Link Ruleset for their relation label.",
    "Function semantics, logic primitives, Event semantics and causal semantics are Ruleset authority.",
    "No semantics are inferred from filenames, extensions, paths, StructureTree addresses, geometry, color or visual appearance.",
    "Importers emit CW canonical data only. Alternate NodeTypes/Rulesets such as UML are selected after import and never create a parallel import format.",
    "The same CW canonical model may be evaluated under another compatible immutable specification set without rewriting canonical truth.",
    "UNRESOLVED != INVALID.",
    "One truth. Many topologies. No duplicate truth."
  ],
  "node_ruleset": {
    "id": "RULESET_NODE",
    "scope": "Entity",
    "root": "Entity",
    "applies_to": "every canonical Node/Entity",
    "nodetype_selector": "Entity.entity_type_ref",
    "nodetype_registry_ref": "CW_NODETYPES",
    "common_fields": ["id", "name", "entity_type_ref", "status", "properties"],
    "section_source": "effective NodeType.sections",
    "section_readers": {
      "links": {"kind":"property_group","source":"Entity.properties","property_type_ref":"link","reader":"Property.ruleset_ref"},
      "functions": {"kind":"property_group","source":"Entity.properties","property_type_ref":"function","reader":"Property.ruleset_ref"},
      "events": {"kind":"property_group","source":"Entity.properties","property_type_ref":"event","reader":"Property.ruleset_ref"},
      "effects": {"kind":"property_group","source":"Entity.properties","property_type_ref":"effect","reader":"Property.ruleset_ref"},
      "data": {"kind":"property_group","source":"Entity.properties","property_type_ref":"data","reader":"Property.ruleset_ref"},
      "representation": {"kind":"property_group","source":"Entity.properties","property_type_ref":"file","reader":"Property.ruleset_ref"},
      "api": {"kind":"property_group","source":"Entity.properties","property_type_ref":"api","reader":"Property.ruleset_ref"},
      "mounts": {"kind":"property_group","source":"Entity.properties","property_type_ref":"mount","reader":"Property.ruleset_ref"},
      "required_links": {"kind":"entity_field","source":"Entity.required_links","field":"required_links","required":true,"empty_allowed":true,"reader":"required_link_schema"},
      "members": {"kind":"entity_field","source":"Entity.members","field":"members","required":true,"empty_allowed":true,"reader":"member_ref_schema"}
    },
    "required_link_schema": {
      "required": ["id", "link_type_ref", "self_endpoint", "min"],
      "optional": ["max", "other_endpoint", "description"],
      "fields": {
        "id":"string",
        "link_type_ref":"string",
        "self_endpoint":"parent_ref|child_ref",
        "min":"non_negative_integer",
        "max":"non_negative_integer|null",
        "other_endpoint":"endpoint_constraint|null",
        "description":"string"
      },
      "semantics": {
        "id":"Stable requirement identity local to the requiring Node.",
        "link_type_ref":"Explicit required relation label. The label need not resolve a dedicated Link Ruleset.",
        "self_endpoint":"Which generic Link endpoint the requiring Node must occupy.",
        "other_endpoint":"Optional opposite-endpoint compatibility constraint."
      }
    },
    "member_ref_schema": {
      "shape": "array<canonical_ref>",
      "allowed_canonical_kinds": ["Entity", "Property"],
      "duplicate_refs": "invalid_model",
      "meaning": "Explicit declared membership of canonical identities in the containing Contract Node scope.",
      "semantics": [
        "CTRCT.members is normative declared contract scope.",
        "Membership does not recursively imply that every implementation-detail FILE is a declared member.",
        "Implementation-side affiliation is expressed independently through contract_affiliation Links."
      ]
    },
    "section_semantics": [
      "A NodeType section declares what is available in the Node projection; RULESET_NODE.section_readers defines how that section is obtained from canonical CW.",
      "property_group sections exist as projections even when no matching Properties exist; an empty group is still a present section.",
      "entity_field sections marked required must exist in canonical Node data; missing required entity_field section is UNREADY unless malformed data makes it INVALID.",
      "Sections not declared by the effective NodeType are not part of that NodeType projection and MUST NOT be invented by a renderer."
    ],
    "common_validation": [
      "Entity.entity_type_ref resolves exactly one NodeType in the selected specification set.",
      "Every declared section id resolves exactly one section reader.",
      "Every canonical Property ruleset_ref resolves exactly one Ruleset in the selected specification set and is compatible with Property.property_type_ref.",
      "Canonical references are resolved without semantic guessing."
    ]
  },
  "shared_value_types": {
    "required_link_ref": {
      "required": ["entity_ref", "required_link_id"],
      "fields": {"entity_ref":"canonical_entity_ref","required_link_id":"string"},
      "meaning":"Explicitly binds one canonical Link Property to one concrete Required Link instance on one Node.",
      "requirement_identity":"entity_ref + required_link_id",
      "one_link_one_requirement":true
    },
    "function_logic": {
      "required":["primitive_set_ref","body"],
      "optional":["representations"],
      "fields":{"primitive_set_ref":"local_logic_primitive_set_ref","body":"array<logic_statement>","representations":"array<logic_representation>"},
      "meaning":"Structured language-independent normalized Function behavior."
    }
  },
  "logic_primitive_sets": [
    {
      "id":"CW_LOGIC_PRIMITIVES",
      "version":"1.0.0",
      "role":"language_independent_normalized_function_logic",
      "scope":"Function.logic",
      "representation_independent":true,
      "ordered_fields":["Function.logic.body","if.then","if.else","while.body","loop.body"],
      "value_forms": {
        "canonical_ref":{"shape":{"ref":"canonical_ref"},"meaning":"Explicit canonical Entity/Property reference."},
        "local_ref":{"shape":{"local_ref":"string"},"meaning":"Function.logic-local symbol.","scope":"containing Function.logic"},
        "literal":{"shape":{"literal":"inert_semantic_value"},"meaning":"Inline inert literal value."},
        "expression":{"shape":"one expression-class primitive object from this primitive set","meaning":"Nested language-independent logic expression."}
      },
      "primitives": [
        {"op":"read","class":"expression","category":"data","required":["op","source"],"optional":[],"fields":{"op":"string","source":"logic_value"},"semantics":"Read/evaluate a referenced value without declaring mutation.","reference_constraints":{"canonical source refs":{"allowed_canonical_kinds":["Property"],"allowed_property_type_refs":["data"]}}},
        {"op":"write","class":"statement","category":"data","required":["op","target","value"],"optional":[],"fields":{"op":"string","target":"canonical_ref","value":"logic_value"},"semantics":"Write/replace the modeled value of an explicit canonical Data Property.","reference_constraints":{"target":{"allowed_canonical_kinds":["Property"],"allowed_property_type_refs":["data"]}}},
        {"op":"assign","class":"statement","category":"data","required":["op","target","value"],"optional":[],"fields":{"op":"string","target":"local_ref","value":"logic_value"},"semantics":"Assign a value to a Function.logic-local symbol."},
        {"op":"call","class":"statement","category":"invocation","required":["op","call_ref"],"optional":[],"fields":{"op":"string","call_ref":"canonical_ref"},"semantics":"Invoke the explicit canonical function_call Link identified by call_ref.","reference_constraints":{"call_ref":{"allowed_canonical_kinds":["Property"],"allowed_property_type_refs":["link"],"required_link_type_ref":"function_call"}}},
        {"op":"return","class":"statement","category":"invocation","required":["op"],"optional":["value"],"fields":{"op":"string","value":"logic_value"},"semantics":"Return from the containing Function logic."},
        {"op":"if","class":"statement","category":"control","required":["op","condition","then"],"optional":["else"],"fields":{"op":"string","condition":"logic_value","then":"array<logic_statement>","else":"array<logic_statement>"},"ordered":{"then":true,"else":true},"semantics":"Evaluate condition once and execute the selected modeled branch."},
        {"op":"while","class":"statement","category":"control","required":["op","condition","body"],"optional":[],"fields":{"op":"string","condition":"logic_value","body":"array<logic_statement>"},"ordered":{"body":true},"semantics":"Evaluate condition before each modeled iteration; repeat body while true."},
        {"op":"loop","class":"statement","category":"control","required":["op","body"],"optional":[],"fields":{"op":"string","body":"array<logic_statement>"},"ordered":{"body":true},"semantics":"Represent an unconditional/generic repeated body without asserting runtime iteration count."},
        {"op":"and","class":"expression","category":"boolean","required":["op","args"],"optional":[],"fields":{"op":"string","args":"array<logic_value>","min_args":2},"args_ordered":false,"semantics":"Boolean conjunction."},
        {"op":"or","class":"expression","category":"boolean","required":["op","args"],"optional":[],"fields":{"op":"string","args":"array<logic_value>","min_args":2},"args_ordered":false,"semantics":"Boolean inclusive disjunction."},
        {"op":"xor","class":"expression","category":"boolean","required":["op","args"],"optional":[],"fields":{"op":"string","args":"array<logic_value>","min_args":2},"args_ordered":false,"semantics":"Boolean exclusive disjunction; true for an odd number of true args."},
        {"op":"not","class":"expression","category":"boolean","required":["op","arg"],"optional":[],"fields":{"op":"string","arg":"logic_value"},"semantics":"Boolean negation."},
        {"op":"eq","class":"expression","category":"comparison","required":["op","left","right"],"optional":[],"fields":{"op":"string","left":"logic_value","right":"logic_value"},"semantics":"Equality comparison."},
        {"op":"ne","class":"expression","category":"comparison","required":["op","left","right"],"optional":[],"fields":{"op":"string","left":"logic_value","right":"logic_value"},"semantics":"Inequality comparison."},
        {"op":"lt","class":"expression","category":"comparison","required":["op","left","right"],"optional":[],"fields":{"op":"string","left":"logic_value","right":"logic_value"},"semantics":"Strict less-than comparison."},
        {"op":"lte","class":"expression","category":"comparison","required":["op","left","right"],"optional":[],"fields":{"op":"string","left":"logic_value","right":"logic_value"},"semantics":"Less-than-or-equal comparison."},
        {"op":"gt","class":"expression","category":"comparison","required":["op","left","right"],"optional":[],"fields":{"op":"string","left":"logic_value","right":"logic_value"},"semantics":"Strict greater-than comparison."},
        {"op":"gte","class":"expression","category":"comparison","required":["op","left","right"],"optional":[],"fields":{"op":"string","left":"logic_value","right":"logic_value"},"semantics":"Greater-than-or-equal comparison."}
      ],
      "rules": [
        "Primitive op resolves exactly once inside the selected primitive set.",
        "Function.logic.body and nested control bodies are ordered.",
        "Boolean and/or/xor args are unordered; comparison left/right are directional.",
        "call_ref resolves a canonical function_call Link whose caller endpoint is the containing Function.",
        "Optional source representations never become canonical logic authority."
      ]
    }
  ],
  "flow_patterns": [
    {"id":"static","name":"Static","legs":[]},
    {"id":"one_way","name":"One Way","legs":[{"phase":"transfer","direction":"parent_ref_to_child_ref"}]},
    {"id":"request_reply","name":"Request Reply","legs":[{"phase":"request","direction":"child_ref_to_parent_ref"},{"phase":"reply","direction":"parent_ref_to_child_ref"}]},
    {"id":"call_return","name":"Call Return","legs":[{"phase":"call","direction":"parent_ref_to_child_ref"},{"phase":"return","direction":"child_ref_to_parent_ref"}]},
    {"id":"continuous","name":"Continuous","legs":[{"phase":"stream","direction":"parent_ref_to_child_ref","continuous":true}]}
  ],
  "property_rulesets": [
    {"id":"RULESET_MOUNT","property_type_ref":"mount","value_schema":{"required":["mount_type_ref","target_ref","properties"],"optional":[],"fields":{"mount_type_ref":"string","target_ref":"canonical_or_external_ref","properties":"object"}},"reference_constraints":{"target_ref":{"policy":"broad_by_design","allowed_reference_classes":["canonical_identity_ref","external_ref"]}}},
    {"id":"RULESET_EVENT","property_type_ref":"event","value_schema":{"required":["event_type_ref","properties"],"optional":[],"fields":{"event_type_ref":"string","properties":"object"}}},
    {"id":"RULESET_EFFECT","property_type_ref":"effect","value_schema":{"required":["effect_type_ref","properties"],"optional":[],"fields":{"effect_type_ref":"string","properties":"object"}}},
    {"id":"RULESET_DATA","property_type_ref":"data","value_schema":{"required":["data_type_ref","value","properties"],"optional":[],"fields":{"data_type_ref":"string","value":"inert_semantic_value","properties":"object"}}},
    {
      "id":"RULESET_FUNCTION","property_type_ref":"function",
      "value_schema":{"required":["function_type_ref","properties"],"optional":["input_refs","output_refs","logic"],"fields":{"function_type_ref":"string","properties":"object","input_refs":"array<canonical_ref>","output_refs":"array<canonical_ref>","logic":"function_logic"}},
      "reference_constraints":{"input_refs":{"policy":"broad_by_design","allowed_reference_class":"canonical_identity_ref","allowed_canonical_kinds":["Entity","Property"]},"output_refs":{"policy":"broad_by_design","allowed_reference_class":"canonical_identity_ref","allowed_canonical_kinds":["Entity","Property"]}},
      "logic_schema":{"required":["primitive_set_ref","body"],"optional":["representations"],"fields":{"primitive_set_ref":"local_logic_primitive_set_ref","body":"array<logic_statement>","representations":"array<logic_representation>"},"ordered":{"body":true},"representation_item_schema":{"required":["representation_ref","source"],"optional":[],"fields":{"representation_ref":"string","source":"string"}}},
      "logic_semantics":{"role":"canonical_normalized_functional_behavior","primitive_authority":"Function.logic.primitive_set_ref + Function.logic.body","representation_vocabulary":"open","representation_examples":["python","javascript","sql","hgi"],"representations_are_canonical_authority":false,"parse_representation_to_invent_missing_semantics":false,"runtime_execution_claim":false,"implementation_correspondence_claim":false}
    },
    {"id":"RULESET_FILE","property_type_ref":"file","value_schema":{"required":["filename","properties"],"optional":[],"fields":{"filename":"string","properties":"object"}},"rule":"filename identifies a physical representation; extension and path are not canonical semantic authority."},
    {"id":"RULESET_API","property_type_ref":"api","value_schema":{"required":["api_type_ref","input_refs","output_refs","properties"],"optional":["endpoint"],"fields":{"api_type_ref":"string","input_refs":"array<canonical_ref>","output_refs":"array<canonical_ref>","endpoint":"string","properties":"object"}},"reference_constraints":{"input_refs":{"policy":"constrained","allowed_reference_class":"canonical_identity_ref","allowed_canonical_kinds":["Entity"],"allowed_nodetype_refs":["input","user_input","file_input","stream_input"],"nodetype_matching":"exact_or_inherits_from"},"output_refs":{"policy":"constrained","allowed_reference_class":"canonical_identity_ref","allowed_canonical_kinds":["Entity"],"allowed_nodetype_refs":["output","user_output","file_output","stream_output","derived_output"],"nodetype_matching":"exact_or_inherits_from"}}}
  ],
  "link_rulesets": [
    {
      "id":"RULESET_LINK","property_type_ref":"link","link_type_ref":"*","relation_policy":"open",
      "value_schema":{"required":["link_type_ref","parent_ref","child_ref","properties"],"optional":["required_link_ref"],"fields":{"link_type_ref":"string","parent_ref":"canonical_ref","child_ref":"canonical_ref","properties":"object","required_link_ref":"required_link_ref|null"}},
      "semantic_roles":{"parent_ref":"parent","child_ref":"child"},
      "navigation":{"enabled":true,"relation_source":"value.link_type_ref","bidirectional_lookup":true},
      "relation_resolution": {
        "canonical_topology_ref": {"match":"link_type_ref starts with #","resolution":"single canonical identity namespace","target_kind":"Entity","target_nodetype_ref":"topology_entity","meaning":"The resolved Entity identity selects the topology in which parent_ref -> child_ref is a hierarchy edge."},
        "literal_relation": {"match":"link_type_ref does not start with #","resolution":"none","meaning":"Preserve the exact literal relation name. Prefix-looking text such as ABS:Runtime:dependency does not become a canonical identity reference."}
      },
      "rule":"Generic Link reads and preserves the explicit relation selector and endpoints. A leading # selects a canonical topology identity; without # the selector remains a literal open relation name. No additional semantics are inferred."
    },
    {"id":"RULESET_LINK_DEPENDENCY","property_type_ref":"link","link_type_ref":"dependency","relation_policy":"fixed","value_schema":{"required":["link_type_ref","parent_ref","child_ref","properties"],"optional":["required_link_ref"],"fields":{"link_type_ref":"string","parent_ref":"canonical_ref","child_ref":"canonical_ref","properties":"object","required_link_ref":"required_link_ref|null"}},"semantic_roles":{"parent_ref":"dependency_target","child_ref":"dependent"},"property_owner":"dependent","unresolved_impact":{"from_role":"dependency_target","to_role":"dependent"}},
    {"id":"RULESET_LINK_OWNERSHIP","property_type_ref":"link","link_type_ref":"ownership","relation_policy":"fixed","value_schema":{"required":["link_type_ref","parent_ref","child_ref","properties"],"optional":["required_link_ref"],"fields":{"link_type_ref":"string","parent_ref":"canonical_ref","child_ref":"canonical_ref","properties":"object","required_link_ref":"required_link_ref|null"}},"semantic_roles":{"parent_ref":"owner","child_ref":"owned"},"property_owner":"owned","unresolved_impact":{"from_role":"owner","to_role":"owned"},"constraints":["Each owned endpoint may have zero or one active ownership owner."]},
    {"id":"RULESET_LINK_AUTHORITY","property_type_ref":"link","link_type_ref":"authority","relation_policy":"fixed","value_schema":{"required":["link_type_ref","parent_ref","child_ref","properties"],"optional":["required_link_ref"],"fields":{"link_type_ref":"string","parent_ref":"canonical_ref","child_ref":"canonical_ref","properties":"object","required_link_ref":"required_link_ref|null"}},"semantic_roles":{"parent_ref":"authority","child_ref":"governed"},"property_owner":"governed","unresolved_impact":{"from_role":"authority","to_role":"governed"}},
    {"id":"RULESET_LINK_CONTAINMENT","property_type_ref":"link","link_type_ref":"containment","relation_policy":"fixed","value_schema":{"required":["link_type_ref","parent_ref","child_ref","properties"],"optional":["required_link_ref"],"fields":{"link_type_ref":"string","parent_ref":"canonical_ref","child_ref":"canonical_ref","properties":"object","required_link_ref":"required_link_ref|null"}},"semantic_roles":{"parent_ref":"container","child_ref":"contained"},"property_owner":"contained","unresolved_impact":{"from_role":"container","to_role":"contained"}},
