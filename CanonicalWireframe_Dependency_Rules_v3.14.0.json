    {"id":"RULESET_LINK_EVENT_READ","property_type_ref":"link","link_type_ref":"event_read","relation_policy":"fixed","value_schema":{"required":["link_type_ref","parent_ref","child_ref","properties"],"optional":["required_link_ref"],"fields":{"link_type_ref":"string","parent_ref":"canonical_ref","child_ref":"canonical_ref","properties":"object","required_link_ref":"required_link_ref|null"}},"semantic_roles":{"parent_ref":"observed_source","child_ref":"event"},"property_owner":"event","endpoint_constraints":{"child_ref":["property:event"]},"flow":{"resolver":"parent_owner_nodetype","nodetype_matching":"exact_or_inherits_from","cases":[{"parent_owner_nodetype_ref":"static_file","pattern_ref":"one_way"},{"parent_owner_nodetype_ref":"database","pattern_ref":"request_reply"},{"parent_owner_nodetype_ref":"api","pattern_ref":"request_reply"},{"parent_owner_nodetype_ref":"stream_input","pattern_ref":"continuous"}],"no_match":"unready"},"unresolved_impact":{"from_role":"observed_source","to_role":"event"},"dependency_derivation":{"dependency_forming":true,"cross_owner_only":true,"used_role":"observed_source","consumer_role":"event"}},
    {"id":"RULESET_LINK_EVENT_INPUT","property_type_ref":"link","link_type_ref":"event_input","relation_policy":"fixed","value_schema":{"required":["link_type_ref","parent_ref","child_ref","properties"],"optional":["required_link_ref"],"fields":{"link_type_ref":"string","parent_ref":"canonical_ref","child_ref":"canonical_ref","properties":"object","required_link_ref":"required_link_ref|null"}},"semantic_roles":{"parent_ref":"input_source","child_ref":"event"},"property_owner":"event","endpoint_constraints":{"child_ref":["property:event"]},"flow":{"pattern_ref":"one_way"},"unresolved_impact":{"from_role":"input_source","to_role":"event"},"dependency_derivation":{"dependency_forming":true,"cross_owner_only":true,"used_role":"input_source","consumer_role":"event"}},
