{
  "id": "UML_NODETYPES",
  "name": "UML NodeTypes",
  "version": "1.0.1",
  "ccf_ref": "CANONICAL_CONTRACT_FORMAT",
  "namespace": "uml",
  "purpose": "Define UML Entity categories and the machine-significant Property types each UML NodeType owns or may own.",
  "principles": [
    "Entity core fields such as id and name remain CCF fields and are not duplicated as UML Properties.",
    "NodeTypes define node-local Property expectations.",
    "Relationships to other Entities are Links interpreted by UML Dependency Rules, not NodeType-owned relationship fields.",
    "NodeTypes do not define relationship interpretation.",
    "NodeTypes do not define flow or traversal semantics.",
    "NodeTypes do not define rendering or layout.",
    "Missing expected Properties make a node unready for rules that require them; they do not make the node invalid.",
    "UNRESOLVED != INVALID"
  ],
  "resolution": {
    "registry_ref": "UML_NODETYPES",
    "rule": "Entity.entity_type_ref resolves a local NodeType id inside the explicitly active UML_NODETYPES registry.",
    "unresolved_state": "unready"
  },
  "nodetype_schema": {
    "required": [
      "id",
      "name",
      "required_property_types",
      "owned_property_types"
    ],
    "optional": [
      "extends",
      "property_cardinality",
      "description"
    ]
  },
