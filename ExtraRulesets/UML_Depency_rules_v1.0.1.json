          "link_type_ref",
          "parent_ref",
          "child_ref",
          "properties"
        ],
        "optional": [
          "role_name",
          "multiplicity",
          "navigable",
          "aggregation"
        ],
        "fields": {
          "link_type_ref": "string",
          "parent_ref": "canonical_ref",
          "child_ref": "canonical_ref",
          "properties": "object",
          "role_name": "string",
          "multiplicity": "uml_multiplicity",
          "navigable": "boolean",
          "aggregation": "none|shared|composite"
        }
      },
      "semantic_roles": {
        "parent_ref": "association",
        "child_ref": "participant"
      },
      "property_owner": "parent_owner",
      "endpoint_constraints": {
        "parent_owner_nodetypes": [
          "association"
        ]
      },
      "constraints": [
        "An Association may have two or more association_end Links.",
        "aggregation=shared or composite is expressed on the Association End at the whole/composite side.",
        "For aggregation=composite, a part instance is composite-owned according to UML composition semantics."
      ]
