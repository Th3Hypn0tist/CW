{
  "id": "UML_DEPENDENCY_RULES",
  "name": "UML Dependency Rules",
  "version": "1.0.1",
  "ccf_ref": "CANONICAL_CONTRACT_FORMAT",
  "nodetypes_ref": "UML_NODETYPES",
  "purpose": "Interpret UML semantics over CCF Entities and Link Properties without introducing a parallel UML relationship store.",
  "principles": [
    "All UML relationships are represented through CCF Link Properties.",
    "UML Dependency Rules interpret Link Properties; they do not define a parallel relation data model.",
    "Endpoint roles are explicit.",
    "Direction is semantic and is not inferred from visual placement.",
    "Undirected or n-ary UML Association is represented as an Association Entity with Association End Links.",
    "Relationship-specific machine-significant values live in the Link Property value defined by the applicable Ruleset.",
    "Unresolved rule requirements produce unready state, not invalid canonical data.",
    "UNRESOLVED != INVALID"
  ],
