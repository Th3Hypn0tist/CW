  "constraints": {
    "invariants": [
      {
        "id": "CMS_ROOT_IS_ABSTRACTION",
        "rule": "#ABS:UltralightCMS is an Abstraction Node and owns no Event, Effect, Data or Function Property."
      },
      {
        "id": "OPEN_PAGE_EVENT_IS_INDEX",
        "rule": "EVENT_OPEN_PAGE belongs to #FILE:index.html and is handled by FUNCTION_OPEN_PAGE on the same Node."
      },
      {
        "id": "OPEN_PAGE_CALLS_RENDER_PAGE",
        "rule": "FUNCTION_OPEN_PAGE explicitly calls FUNCTION_RENDER_PAGE on #FILE:renderer.js."
      },
      {
        "id": "RENDER_PAGE_CALLS_READERS",
        "rule": "FUNCTION_RENDER_PAGE explicitly calls FUNCTION_READ_CONTENT and FUNCTION_READ_STYLE."
      },
      {
        "id": "READ_CONTENT_READS_CONTENT_JSON",
        "rule": "FUNCTION_READ_CONTENT explicitly reads DATA_CONTENT_DOCUMENT from #FILE:content.json and exposes DATA_READ_CONTENT."
      },
      {
        "id": "READ_STYLE_READS_STYLE_CSS",
        "rule": "FUNCTION_READ_STYLE explicitly reads DATA_STYLE_STYLESHEET from #FILE:style.css and exposes DATA_READ_STYLE."
      },
      {
        "id": "OPEN_PAGE_CAUSES_RENDER_EFFECT",
        "rule": "EVENT_OPEN_PAGE explicitly causes EFFECT_RENDER_PAGE on #FILE:renderer.js through event_effect."
      },
      {
        "id": "RENDER_EFFECT_TARGETS_INDEX",
        "rule": "EFFECT_RENDER_PAGE explicitly targets DATA_INDEX_DOCUMENT on #FILE:index.html."
      },
      {
        "id": "DEPENDENCY_CHAIN_EXPLICIT",
        "rule": "index.html depends on renderer.js; renderer.js depends on content.json and style.css."
      },
      {
        "id": "REQUEST_AND_EFFECT_CROSS_DEPENDENCY_OPPOSITE_DIRECTIONS",
        "rule": "The open-page Event-to-Effect causal edge crosses from dependent index.html toward dependency renderer.js, while the render Effect target crosses from renderer.js back toward dependent index.html."
      },
      {
        "id": "NO_CAUSAL_INFERENCE_FROM_DEPENDENCY",
        "rule": "Dependency Links remain structural semantics. Event, handler, Function-call, Effect and target semantics remain explicit canonical Properties."
      }
    ]
  },
  "references": [
    {
      "id": "REF_CW_CORE",
      "target_ref": "CW_CORE@1.1.0",
      "purpose": "Immutable CW Core specification set v1.1.0 defining Canonical Contract Format 2.4.3, CanonicalWireframe NodeTypes 1.18.0 and CanonicalWireframe Dependency Rules 3.14.0 used to interpret this artifact."
    }
  ],
  "gaps": [],
  "prose": {
    "summary": "Ultralight CMS is one #ABS abstraction over four #FILE Nodes. index.html owns the open_page Event and handler Function. The handler calls renderer.js render_page; render_page calls read_content and read_style, whose Data inputs resolve to content.json and style.css. The Event explicitly causes a render_page Effect on renderer.js, and that Effect explicitly targets the index.html document.",
    "notes": "Causality and dependency remain separate canonical truths. The dependency graph is content.json/style.css -> renderer.js -> index.html. The open-page causal request crosses index.html -> renderer.js, opposite the renderer dependency edge, and the render Effect returns renderer.js -> index.html through its explicit effect_target. Animation is intentionally not defined by this example."
  }
