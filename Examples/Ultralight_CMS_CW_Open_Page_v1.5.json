  "constraints": {
    "invariants": [
      {
        "id": "CMS_ROOT_IS_ABSTRACTION",
        "rule": "#ABS:UltralightCMS is an Abstraction Node and owns no Event or Function Property."
      },
      {
        "id": "PAGE_REQUEST_EVENT_IS_INDEX",
        "rule": "EVENT_PAGE_REQUEST belongs to #FILE:index.html."
      },
      {
        "id": "QUERY_READS_CANONICAL_SOURCES",
        "rule": "FUNCTION_QUERY explicitly consumes DATA_CONTENT_DOCUMENT and DATA_STYLE_STYLESHEET and exposes loaded content/style surfaces."
      },
      {
        "id": "RENDER_WRITES_INDEX_DOCUMENT",
        "rule": "FUNCTION_RENDER explicitly consumes the query outputs and exposes DATA_INDEX_DOCUMENT as its output."
      },
      {
        "id": "DEPENDENCY_CHAIN_EXPLICIT",
        "rule": "index.html depends on renderer.js; renderer.js depends on content.json and style.css."
      },
      {
        "id": "NO_CAUSAL_INFERENCE_FROM_DEPENDENCY",
        "rule": "Dependency Links remain structural semantics and do not replace the explicit Event handler or Function-call semantics."
      }
    ]
  },
